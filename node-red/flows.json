    {
        "id": "f6a375e6f6f9497e",
        "type": "function",
        "z": "1dea392bb9cc936c",
        "name": "Build League Table",
        "func": "\n// 1. Parse the Kafka message\nvar kafkaMessage = typeof msg.payload === \"string\"\n    ? JSON.parse(msg.payload)\n    : msg.payload;\n\n// 2. Extract team statistics\nvar stats = typeof kafkaMessage.value === \"string\"\n    ? JSON.parse(kafkaMessage.value)\n    : kafkaMessage.value;\n\n// 3. Retrieve stored teams\nvar teams = flow.get(\"teams\") || {};\n\n// 4. Update this team's statistics\nteams[stats.teamId] = stats;\n\n// 5. Save the updated state\nflow.set(\"teams\", teams);\n\n// 6. Build league table\nvar table = Object.values(teams);\n\n// 7. Sort by points, goal difference and goals scored\ntable.sort((a, b) =>\n    (b.points - a.points) ||\n    (b.gd - a.gd) ||\n    (b.gf - a.gf)\n);\n\n\n // 8. Build a compact league table\n msg.payload = table.map((team, index) => ({\n     Pos: index + 1,\n     Equipo: team.name,\n     PJ: team.played,\n     G: team.won,\n     E: team.draw,\n     P: team.lost,\n     DG: team.gd,\n     Pts: team.points\n }));\n\n return msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 710,
        "y": 180,
        "wires": [
            [
                "1783641820f6b635",
                "72a7515935e9b224"
            ]
