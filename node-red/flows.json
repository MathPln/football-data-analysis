    {
        "id": "b3ef1b59533da56c",
        "type": "function",
        "z": "1dea392bb9cc936c",
        "name": "Show Team Stats",
        "func": "const selectedTeam = msg.payload;\n\n// Retrieve shared team statistics\nconst teams = flow.get(\"teams\") || {};\n\n// Find selected team\nconst stats = Object.values(teams).find(\n    team => team.name === selectedTeam\n);\n\nif (!stats) {\n    node.warn(\"Team not found: \" + selectedTeam);\n    return null;\n}\n\n// Output 1: Match Results\nconst resultsMsg = {\n    payload: [\n        { category: \"Wins\", value: stats.won },\n        { category: \"Draws\", value: stats.draw },\n        { category: \"Losses\", value: stats.lost }\n    ]\n};\n\n// Output 2: Goals Comparison\nconst goalsMsg = {\n    payload: [\n        { category: \"Goals For\", value: stats.gf },\n        { category: \"Goals Against\", value: stats.ga }\n    ]\n};\n\n// Output 3: Match History (most recent first)\nconst historyMsg = {\n    payload: (stats.history || []).slice().reverse()\n};\n\nreturn [resultsMsg, goalsMsg, historyMsg];\n",
        "outputs": 3,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
