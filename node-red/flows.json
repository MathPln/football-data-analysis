    {
        "id": "format_match_function",
        "type": "function",
        "z": "1dea392bb9cc936c",
        "name": "Format",
        "func": "var count = context.get('matchCount') || 0;\ncount++;\ncontext.set('matchCount', count);\n\n// First parse: Kafka message\nvar kafkaMessage = typeof msg.payload === \"string\"\n    ? JSON.parse(msg.payload)\n    : msg.payload;\n\n// Second parse: actual football match\nvar match = typeof kafkaMessage.value === \"string\"\n    ? JSON.parse(kafkaMessage.value)\n    : kafkaMessage.value;\n\nvar home = match.homeTeam?.shortName || \"Home\";\nvar away = match.awayTeam?.shortName || \"Away\";\nvar matchday = match.matchday || \"?\";\n\nmsg.payload = \"[Match \" + count + \"] Matchday \" +\n    matchday + \" | \" + home + \" vs \" + away;\n\nreturn msg;",
