    {
        "id": "72a7515935e9b224",
        "type": "function",
        "z": "1dea392bb9cc936c",
        "name": "Build Team Options",
        "func": "\nvar teams = msg.payload;\n\n// Sort teams alphabetically\nteams.sort((a, b) => a.Equipo.localeCompare(b.Equipo));\n\n// Create dropdown options\nmsg.ui_update = {\n    options: teams.map(team => ({\n        label: team.Equipo,\n        value: team.Equipo\n    }))\n};\n\n// Avoid selecting a team automatically\ndelete msg.payload;\n\nreturn msg;\n\n\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
