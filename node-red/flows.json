    {
        "id": "format_match_function",
        "type": "function",
        "z": "1dea392bb9cc936c",
        "name": "Format",
        "func": "var count = context.get('matchCount') || 0;\ncount += 1;\ncontext.set('matchCount', count);\n\nvar home = (msg.payload.homeTeam && msg.payload.homeTeam.shortName) ? msg.payload.homeTeam.shortName : 'Home';\nvar away = (msg.payload.awayTeam && msg.payload.awayTeam.shortName) ? msg.payload.awayTeam.shortName : 'Away';\nvar matchday = msg.payload.matchday || '?';\n\nmsg.payload = \"[Match \" + count + \"] Matchday \" + matchday + \" | \" + home + \" vs \" + away;\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
