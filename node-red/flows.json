    {
        "id": "891084cb0bd554f0",
        "type": "function",
        "z": "1dea392bb9cc936c",
        "name": "Build Top Scorers",
        "func": "// 1. Parse Kafka message\nvar kafkaMessage = typeof msg.payload === \"string\"\n    ? JSON.parse(msg.payload)\n    : msg.payload;\n\n// 2. Extract scorer data\nvar scorer = typeof kafkaMessage.value === \"string\"\n    ? JSON.parse(kafkaMessage.value)\n    : kafkaMessage.value;\n\n// 3. Retrieve stored players\nvar players = context.get(\"players\") || {};\n\n// 4. Update player statistics\nvar playerId = scorer.player?.id;\n\nif (playerId == null) {\n    return null;\n}\n\nplayers[playerId] = scorer;\ncontext.set(\"players\", players);\n\n// 5. Sort players by goals, then assists\nvar ranking = Object.values(players);\n\nranking.sort((a, b) =>\n    (b.goals - a.goals) ||\n    ((b.assists || 0) - (a.assists || 0))\n);\n\n// 6. Output 1: Top scorers table\nvar tableMsg = {\n    payload: ranking.map((item, index) => ({\n        Pos: index + 1,\n        Player: item.player?.name || \"Unknown\",\n        Team: item.team?.shortName || item.team?.name || \"-\",\n        Goals: item.goals ?? 0,\n        Assists: item.assists ?? 0,\n        Penalties: item.penalties ?? 0\n    }))\n};\n\n// 7. Output 2: Top 10 scorers chart\nvar chartMsg = {\n    payload: ranking.slice(0, 10).map(item => ({\n        category: (item.player?.name || \"Unknown\").split(\" \").slice(-1)[0],\n        value: item.goals ?? 0\n    }))\n};\n\nreturn [tableMsg, chartMsg];\n",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 830,
        "y": 380,
        "wires": [
            [
                "a020e4debf0fd426"
            ],
            [
                "cht_top_scorers"
            ]
        ]
