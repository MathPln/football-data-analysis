    {
        "id": "f6a375e6f6f9497e",
        "type": "function",
        "z": "1dea392bb9cc936c",
        "name": "Build League Table",
        "func": "// 1. Parse the Kafka message\nvar kafkaMessage = typeof msg.payload === \"string\"\n    ? JSON.parse(msg.payload)\n    : msg.payload;\n\n// 2. Extract team statistics\nvar stats = typeof kafkaMessage.value === \"string\"\n    ? JSON.parse(kafkaMessage.value)\n    : kafkaMessage.value;\n\n// 3. Retrieve stored teams\nvar teams = flow.get(\"teams\") || {};\n\n// 4. Update this team's statistics\nteams[stats.teamId] = stats;\n\n// 5. Save the updated state\nflow.set(\"teams\", teams);\n\n// 6. Build league table\nvar table = Object.values(teams);\n\n// 7. Sort by points, goal difference and goals scored\ntable.sort((a, b) =>\n    (b.points - a.points) ||\n    (b.gd - a.gd) ||\n    (b.gf - a.gf)\n);\n\n// 8. Output 1: Compact league table\nvar tableMsg = {\n    payload: table.map((team, index) => ({\n        Pos: index + 1,\n        Equipo: team.name,\n        PJ: team.played,\n        G: team.won,\n        E: team.draw,\n        P: team.lost,\n        DG: team.gd,\n        Pts: team.points,\n        Form: team.last5 || \"-\",\n        Worker: team.processedBy || \"-\"\n    }))\n};\n\n// 9. Output 2: Top 8 attacks (goals scored) with team colors\nvar teamColors = {\n    \"FCB\": \"#004D98\", \n    \"RMA\": \"#CBD5E1\", \n    \"ATL\": \"#CB3524\", \n    \"BET\": \"#0BB363\", \n    \"RSO\": \"#0067B1\",\n    \"VIL\": \"#FACC15\",\n    \"ATH\": \"#EE2523\",\n    \"SEV\": \"#D91A2A\",\n    \"RAY\": \"#E11D48\",\n    \"CEL\": \"#7DD3FC\", \n    \"VAL\": \"#F97316\", \n    \"OSA\": \"#B91C1C\", \n    \"GET\": \"#2563EB\", \n    \"ESP\": \"#3B82F6\", \n    \"ALA\": \"#1D4ED8\", \n    \"LEV\": \"#7C2D12\", \n    \"ELC\": \"#16A34A\", \n    \"MAL\": \"#0284C7\", \n    \"DEP\": \"#1E40AF\",\n    \"SAN\": \"#15803D\"  \n};\n\nvar topAttacks = table\n    .slice()\n    .sort((a, b) => b.gf - a.gf)\n    .slice(0, 8)\n    .map(team => ({\n        category: team.tla || team.name,\n        value: team.gf\n    }));\n\nvar attacksMsg = {\n    payload: topAttacks,\n    ui_update: {\n        chartOptions: {\n            color: topAttacks.map(item => teamColors[item.category] || \"#64748B\")\n        }\n    }\n};\n\n// 10. Output 3: Season summary line\nvar totalPlayed = table.reduce((sum, t) => sum + t.played, 0);\nvar totalGoals = table.reduce((sum, t) => sum + t.gf, 0);\nvar matchesPlayed = Math.floor(totalPlayed / 2);\nvar avgGoals = matchesPlayed > 0 ? (totalGoals / matchesPlayed).toFixed(2) : \"0.00\";\nvar leader = table[0] ? `${table[0].name} (${table[0].points} pts)` : \"-\";\n\nvar summaryMsg = {\n    payload: `Leader: ${leader}  |  Matches: ${matchesPlayed}  |  Total Goals: ${totalGoals}  |  Avg: ${avgGoals} goals/match`\n};\n\nreturn [tableMsg, attacksMsg, summaryMsg];\n",
        "outputs": 3,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
